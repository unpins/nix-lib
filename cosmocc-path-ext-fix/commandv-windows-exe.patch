+  // on windows, a name whose last component has no dot is also tried
+  // with .com and .exe, in that order, in each directory: cmd.exe's
+  // default PATHEXT minus the scripts CreateProcess can't run. without
+  // it `where`, `echo` or `git` are never found, only `where.exe`.
+  static const char kExts[][5] = {"", ".com", ".exe"};
+  const char *base = memrchr(name, '/', namelen);
+  base = base ? base + 1 : name;
+  int nexts = IsWindows() && !strchr(base, '.') ? 3 : 1;
+
