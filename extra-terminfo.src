# Extra terminfo entries appended to ncurses misc/terminfo.src before
# `tic` runs at build time. Sourced from newer ncurses releases or
# upstream projects when our pinned ncurses (6.5 in nixpkgs 25.11)
# predates the entry, or when the canonical name an emulator sets in
# $TERM is missing from ncurses' alias chain.
#
# Format is the standard terminfo source format (one capability per
# field, comma-separated). tic compiles this into the database;
# --with-fallbacks=<name> then bakes the result into libtinfo.a as
# _nc_fallback[]. Capability lookups at runtime match against all
# aliases on the entry's name line, so adding "xterm-FOO|foo" makes
# both `TERM=xterm-FOO` and `TERM=foo` resolve to one entry.

# xterm-ghostty (Ghostty 1.x). Not in ncurses 6.5; ncurses 6.6 adds a
# separate `ghostty` entry but Ghostty's own install ships richer
# `xterm-ghostty|ghostty|Ghostty` (adds `blink`, refined `sgr`, drops
# dead margin caps). $TERM defaults to xterm-ghostty.
# Source: /usr/share/terminfo/x/xterm-ghostty (Ghostty install).
xterm-ghostty|ghostty|Ghostty,
	am, bce, ccc, hs, km, mc5i, mir, msgr, npc, xenl,
	colors#0x100, cols#80, it#8, lines#24, pairs#0x7fff,
	acsc=++\,\,--..00``aaffgghhiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
	bel=^G, blink=\E[5m, bold=\E[1m, cbt=\E[Z, civis=\E[?25l,
	clear=\E[H\E[2J, cnorm=\E[?12l\E[?25h, cr=\r,
	csr=\E[%i%p1%d;%p2%dr, cub=\E[%p1%dD, cub1=^H,
	cud=\E[%p1%dB, cud1=\n, cuf=\E[%p1%dC, cuf1=\E[C,
	cup=\E[%i%p1%d;%p2%dH, cuu=\E[%p1%dA, cuu1=\E[A,
	cvvis=\E[?12;25h, dch=\E[%p1%dP, dch1=\E[P, dim=\E[2m,
	dl=\E[%p1%dM, dl1=\E[M, dsl=\E]2;\007, ech=\E[%p1%dX,
	ed=\E[J, el=\E[K, el1=\E[1K, flash=\E[?5h$<100/>\E[?5l,
	fsl=^G, home=\E[H, hpa=\E[%i%p1%dG, ht=^I, hts=\EH,
